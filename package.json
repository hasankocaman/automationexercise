{
  "name": "learnqa-dev",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "QA Learning Platform for Selenium, Playwright, Java, Python, SQL, API testing, DevOps and cloud tools",
  "scripts": {
    "predev": "node scripts/generate-data-stubs.mjs",
    "dev": "vite --host",
    "dev:prod": "vite --host --mode prodtest",
    "generate:data-stubs": "node scripts/generate-data-stubs.mjs",
    "build": "node scripts/check-seo.mjs && node scripts/generate-section-slugs.mjs --check && node scripts/check-content-integrity.mjs && node scripts/check-i18n-leaks.mjs && node scripts/audit-interview-questions.mjs && node scripts/audit-learning-blocks.mjs && node scripts/generate-seo-files.mjs && node scripts/generate-data-stubs.mjs && node scripts/generate-mastery-manifest.mjs && node scripts/generate-interview-showcase.mjs && vite build && node scripts/generate-static-routes.mjs && node scripts/check-dist-seo.mjs",
    "content:check": "node scripts/check-content-integrity.mjs",
    "i18n:check": "node scripts/check-i18n-leaks.mjs",
    "i18n:baseline": "node scripts/check-i18n-leaks.mjs --update-baseline",
    "mastery:manifest": "node scripts/generate-mastery-manifest.mjs",
    "seo:check": "node scripts/check-seo.mjs",
    "seo:check-dist": "node scripts/check-dist-seo.mjs",
    "seo:files": "node scripts/generate-seo-files.mjs",
    "seo:section-slugs": "node scripts/generate-section-slugs.mjs",
    "seo:lcp": "node scripts/measure-mobile-lcp.mjs",
    "preview": "vite preview",
    "pretest:e2e": "node scripts/kill-stale-test-processes.mjs",
    "test:e2e": "playwright test",
    "pretest:interview-flows": "node scripts/kill-stale-test-processes.mjs",
    "test:interview-flows": "playwright test --config=playwright.interview-flows.config.ts",
    "pretest:quiz-audit": "node scripts/kill-stale-test-processes.mjs",
    "test:quiz-audit": "playwright test --config=playwright.quiz-audit.config.ts",
    "pretest:cross-browser": "node scripts/kill-stale-test-processes.mjs",
    "test:cross-browser": "playwright test --config=playwright.cross-browser.config.ts",
    "pretest:release-gate": "npm run build",
    "test:release-gate": "playwright test --config=playwright.release-gate.config.ts",
    "audit:interactive": "node scripts/audit-interactive.mjs",
    "audit:interactive:missing": "node scripts/audit-interactive.mjs --missing",
    "audit:interview-questions": "node scripts/audit-interview-questions.mjs",
    "audit:learning-blocks": "node scripts/audit-learning-blocks.mjs",
    "audit:animation": "node scripts/audit-animation-coverage.mjs",
    "audit:animation:missing": "node scripts/audit-animation-coverage.mjs --missing",
    "postinstall": "simple-git-hooks",
    "generate:interview-showcase": "node scripts/generate-interview-showcase.mjs"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/check-content-integrity.mjs && node scripts/check-i18n-leaks.mjs",
    "pre-push": "bash scripts/pre-push-tests.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "lucide-react": "^1.21.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "cross-env": "^10.1.0",
    "msw": "^2.12.7",
    "postcss": "^8.4.32",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^3.3.6",
    "vite": "^5.0.8"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
